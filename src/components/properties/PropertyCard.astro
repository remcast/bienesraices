---
// src/components/properties/PropertyCard.astro
import { Bed, Bath } from "lucide-astro";
import FavoriteButton from "./FavoriteButton.jsx";

interface Props {
    titulo: string;
    precio: number;
    tipo: string;
    habitaciones: number;
    banos: number;
    imagen_url: string;
    id: string;
}

const { titulo, precio, tipo, habitaciones, banos, imagen_url, id } =
    Astro.props;

const formatPrice = (amount: number) => {
    return new Intl.NumberFormat("es-MX", {
        style: "currency",
        currency: "MXN",
        maximumFractionDigits: 0,
    }).format(amount);
};
---

<article
    class="bg-slate-800 rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300 border border-pink-500 group"
>
    <div class="relative h-48 overflow-hidden">
        <img src={imagen_url} alt={titulo} class="w-full h-full object-cover" />
        <span
            class={`absolute top-2 left-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide text-white ${
                tipo === "venta" ? "bg-blue-600" : "bg-green-600"
            }`}
        >
            {tipo}
        </span>
        <FavoriteButton client:load propertyId={id} />
    </div>

    <div class="p-5">
        <h3 class="text-xl font-bold text-white mb-2 truncate" title={titulo}>
            {titulo}
        </h3>

        <p class="text-2xl font-bold text-blue-400 mb-4">
            {formatPrice(precio)}
        </p>

        <div
            class="flex justify-between text-slate-300 text-sm border-t border-slate-700 pt-4"
        >
            <div class="flex items-center gap-2">
                <Bed size={18} class="text-pink-500" />
                <span>{habitaciones} Hab.</span>
            </div>
            <div class="flex items-center gap-2">
                <Bath size={18} class="text-pink-500" />
                <span>{banos} Baños</span>
            </div>
        </div>

        <a
            href={`/propiedades/${id}`}
            class="block w-full text-center mt-6 bg-slate-900 border border-slate-700 text-white py-3 rounded-lg hover:bg-pink-600 hover:border-pink-600 transition font-medium"
        >
            Ver Detalles
        </a>
    </div>
</article>
