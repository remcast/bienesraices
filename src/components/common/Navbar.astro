---
import UserMenu from "../auth/UserMenu.jsx";
const pathname = Astro.url.pathname;
const isHome = pathname === "/";

// 1. Aquí defines los tamaños.
// Si es Home usa el primero, si es Propiedades (u otro) usa el segundo.
const logoSize = isHome ? "text-4xl md:text-5xl" : "text-2xl md:text-3xl";
const linkSize = isHome ? "text-sm" : "text-base";
---

<nav
    class={`${
        isHome
            ? "absolute top-8 left-0 right-0 mx-4 md:mx-38 z-50 rounded-xl"
            : "relative w-full bg-slate-600 shadow-xl"
    } 
        text-white p-4 transition-all duration-300`}
>
    <div class="container mx-auto flex justify-between items-center">
        <a href="/" class="text-2xl md:text-3xl text-white tracking-wide ml-8">
            BIENESRAICES
        </a>

        <ul class="flex gap-8 items-center">
            <li>
                <a
                    href="/"
                    class="hover:text-blue-300 transition font-medium text-sm tracking-widest"
                >
                    INICIO
                </a>
            </li>
            <li>
                <a
                    href="/propiedades"
                    class="hover:text-blue-300 transition font-medium text-sm tracking-widest"
                >
                    PROPIEDADES
                </a>
            </li>
            <li>
                <a
                    href="/contacto"
                    class={`hover:text-blue-300 transition font-medium tracking-widest ${linkSize}`}
                >
                    CONTACTO
                </a>
            </li>
            <li>
                <a
                    href="/mapa-de-sitio"
                    class={`hover:text-blue-300 transition font-medium tracking-widest ${linkSize}`}
                >
                    MAPA DE SITIO
                </a>
            </li>
            <li>
                <UserMenu client:load />
            </li>
        </ul>
    </div>
</nav>
