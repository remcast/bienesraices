---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/common/ContactForm.jsx";
import { Mail, Phone, MapPin } from "lucide-astro";
---

<Layout title="Contáctanos | Inmobiliaria">
    <div class="relative pt-32 pb-20 px-4 min-h-screen">
        {/* Fondo decorativo */}
        <div
            class="absolute top-0 left-0 w-full h-[50vh] bg-slate-800 -z-10 rounded-b-[3rem]"
        >
        </div>

        <div class="container mx-auto">
            <div class="text-center mb-16 text-white">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    Hablemos de tu futuro hogar
                </h1>
                <p class="text-slate-300 text-lg max-w-2xl mx-auto">
                    Estamos listos para asesorarte en la compra, venta o renta
                    de tu propiedad.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                {/* Columna Izquierda: Info de contacto */}
                <div class="space-y-8 lg:mt-10">
                    <div
                        class="bg-white/5 backdrop-blur-lg border border-white/10 p-8 rounded-2xl"
                    >
                        <h3 class="text-2xl font-bold text-white mb-6">
                            Información de Contacto
                        </h3>

                        <div class="space-y-6">
                            <div class="flex items-start gap-4">
                                <div
                                    class="bg-pink-500/20 p-3 rounded-lg text-pink-500"
                                >
                                    <MapPin size={24} />
                                </div>
                                <div>
                                    <h4 class="text-white font-bold">
                                        Oficina Principal
                                    </h4>
                                    <p class="text-slate-400">
                                        Av. Paseo Tabasco 1234, Villahermosa,
                                        Tabasco.
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div
                                    class="bg-blue-500/20 p-3 rounded-lg text-blue-500"
                                >
                                    <Phone size={24} />
                                </div>
                                <div>
                                    <h4 class="text-white font-bold">
                                        Teléfono
                                    </h4>
                                    <p class="text-slate-400">
                                        +52 (993) 123 4567
                                    </p>
                                    <p class="text-slate-400">
                                        +52 (993) 987 6543
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div
                                    class="bg-purple-500/20 p-3 rounded-lg text-purple-500"
                                >
                                    <Mail size={24} />
                                </div>
                                <div>
                                    <h4 class="text-white font-bold">Email</h4>
                                    <p class="text-slate-400">
                                        contacto@inmobiliaria.com
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {/* Columna Derecha: Formulario */}
                <div>
                    <ContactForm client:load />
                </div>
            </div>
        </div>
    </div>
</Layout>
