---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";
import { Bed, Bath, MapPin, Home, ArrowLeft } from "lucide-astro";
import FavoriteButton from "../../components/properties/FavoriteButton.jsx";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";

// 1. Obtener ID de la URL
const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/404");
}

// 2. Consultar Supabase
const { data: propiedad, error } = await supabase
    .from("propiedades")
    .select("*")
    .eq("id", id)
    .eq("status", "publicada")
    .single();

if (error || !propiedad) {
    console.error("Error fetching property:", error);
    return Astro.redirect("/404");
}

const formatPrice = (amount: number) => {
    if (!amount) return "$0";
    return new Intl.NumberFormat("es-MX", {
        style: "currency",
        currency: "MXN",
        maximumFractionDigits: 0,
    }).format(amount);
};
---

<Layout title={`${propiedad.titulo} | Inmobiliaria`}>
    <div class="pt-36 pb-20 min-h-screen bg-slate-900">
        <div class="container mx-auto px-8 lg:px-20">
            {/* Navegación y Breadcrumbs */}
            <div class="mt-6">
                <Breadcrumbs
                    items={[
                        { label: "Propiedades", href: "/propiedades" },
                        { label: propiedad.titulo },
                    ]}
                />
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                {/* Columna Izquierda: Imagen y Detalles Principales */}
                <div class="lg:col-span-2 space-y-8">
                    {/* Imagen Hero */}
                    <div
                        class="relative w-full h-[400px] md:h-[500px] rounded-2xl overflow-hidden shadow-2xl border border-slate-700 group"
                    >
                        <img
                            src={propiedad.imagen_url}
                            alt={propiedad.titulo}
                            class="w-full h-full object-cover transition duration-700 group-hover:scale-105"
                        />

                        {
                            /* Botón Favorito Grande (El componente ya tiene position: absolute) */
                        }
                        <FavoriteButton client:load propertyId={propiedad.id} />

                        <span
                            class={`absolute top-4 left-8 px-4 py-2 rounded-full text-sm font-bold uppercase tracking-wide text-white shadow-lg ${
                                propiedad.tipo === "venta"
                                    ? "bg-blue-600"
                                    : "bg-green-600"
                            }`}
                        >
                            {propiedad.tipo}
                        </span>
                    </div>

                    {/* Descripción y Características */}
                    <div
                        class="bg-slate-800 rounded-2xl p-8 border border-slate-700 shadow-lg"
                    >
                        <h1
                            class="text-3xl md:text-4xl font-bold text-white mb-4"
                        >
                            {propiedad.titulo}
                        </h1>

                        <div
                            class="flex flex-wrap gap-6 text-slate-300 mb-8 border-b border-slate-700 pb-8"
                        >
                            <div class="flex items-center gap-2">
                                <Bed class="text-pink-500" size={24} />
                                <span class="text-lg"
                                    >{propiedad.habitaciones} Habitaciones</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <Bath class="text-pink-500" size={24} />
                                <span class="text-lg"
                                    >{propiedad.banos} Baños</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <MapPin class="text-pink-500" size={24} />
                                <span class="text-lg"
                                    >{propiedad.ubicacion}</span
                                >
                            </div>
                        </div>

                        <h2 class="text-2xl font-bold text-white mb-4">
                            Sobre esta propiedad
                        </h2>
                        <p
                            class="text-slate-300 text-lg leading-relaxed whitespace-pre-line"
                        >
                            {propiedad.descripcion}
                        </p>
                    </div>
                </div>

                {/* Columna Derecha: Sidebar (Precio y Contacto) */}
                <div class="lg:col-span-1">
                    <div
                        class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-lg sticky top-40"
                    >
                        <p
                            class="text-slate-400 text-sm font-bold uppercase mb-2"
                        >
                            Precio de {propiedad.tipo}
                        </p>
                        <div class="text-4xl font-extrabold text-blue-400 mb-8">
                            {formatPrice(propiedad.precio)}
                        </div>

                        <div class="space-y-4">
                            <a
                                href="/contacto"
                                class="block w-full mb-4 py-4 bg-pink-600 hover:bg-pink-700 text-white font-bold text-center rounded-xl transition transform hover:scale-[1.02] shadow-lg shadow-pink-600/20"
                            >
                                Contactar Agente
                            </a>
                            <button
                                class="block w-full py-4 bg-slate-700 hover:bg-slate-600 text-white font-bold text-center rounded-xl transition border border-slate-600"
                                onclick="window.print()"
                            >
                                Imprimir Ficha
                            </button>
                        </div>

                        <div
                            class="mt-8 pt-8 border-t border-slate-700 text-center"
                        >
                            <p class="text-slate-500 text-sm">
                                Referencia: {propiedad.id.slice(0, 8)}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
